# Keep the build context small and keep local state out of the image.
__pycache__/
*.py[cod]
.venv/
venv/

# Local dev DB and its WAL sidecars -- the container's DB lives in the named
# volume, never in the image.
*.db
*.db-wal
*.db-shm

# Export files are bind-mounted at /data/import (compose.yaml), not baked in.
data/

.env
*.egg-info/
